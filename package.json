{
  "name": "crewstars-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check:messages": "node scripts/check-messages.mjs",
    "dev": "next dev",
    "e2e": "playwright test",
    "gen:api": "pnpm --filter @crewstars/api-client gen",
    "lint": "eslint",
    "start": "next start",
    "test": "node scripts/tokens.mjs --check && node scripts/check-messages.mjs && vitest run && pnpm --filter \"./packages/*\" --if-present test",
    "typecheck": "next typegen && tsc --noEmit",
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check"
  },
  "dependencies": {
    "@crewstars/api-client": "workspace:*",
    "@crewstars/i18n": "workspace:*",
    "@crewstars/shared": "workspace:*",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0"
    }
  }
}
