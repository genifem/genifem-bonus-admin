# Where the Next.js server reaches the Crew Stars API (server-side only, never sent to browsers).
# Locally: the API from ../bonus-backend. On Vercel: the public API address,
# e.g. https://api.stars.example.com
API_INTERNAL_URL=http://127.0.0.1:8000

# Server-side only (never NEXT_PUBLIC_). Needed when the API is reached through Caddy, as it
# is from Vercel: it lets the API trust the browser's host and IP this server passes on in
# X-CS-Host / X-CS-Client-IP, and the API's back office routes check that host. Must equal the
# API's CS_PROXY_SECRET; at least 32 characters (openssl rand -base64 48). Leave empty locally.
API_PROXY_SECRET=

# The domain every surface answers under (P7), server-side only and read at run time:
#   {slug}.<base>  an operator's owner portal (the slug is sent upstream as X-Tenant)
#   admin.<base>   the back office
#   <base>         "Find your company"
# Any other host gets a 404. Must equal the API's CS_BASE_DOMAIN. Deployed: stars.genifem.com.
# Locally: localhost, so demo.localhost:3000, admin.localhost:3000 and localhost:3000.
CREWSTARS_BASE_DOMAIN=localhost
